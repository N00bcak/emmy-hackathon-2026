    ld.param.u64 %rd1, [param_0];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [param_1];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %tid.y;
    mov.u32 %r3, %tid.z;
    mov.u32 %r4, %ctaid.x;
    mov.u32 %r5, %ctaid.y;
    mov.u32 %r6, %ctaid.z;
    mad.lo.u32 %r7, %r1, 1, %r2;
    mad.lo.u32 %r8, %r7, 1, %r3;
    mad.lo.u32 %r9, %r4, 1, %r5;
    mad.lo.u32 %r10, %r9, 1, %r6;
    mov.u32 %r1, %r8;
    mov.u32 %r4, %r10;
    mov.u32 %r11, 4;
    mad.lo.u32 %r12, %r10, %r11, %r8;
    and.b32 %r13, %r8, 31;
    shr.u32 %r14, %r8, 5;
    setp.ge.u32 %p1, %r12, 4;
    @%p1 bra kernel_done;
    shr.u32 %r15, %r12, 0;
    mad.lo.s32 %r16, %r15, 1, 0;
    mul.wide.s32 %rd3, %r16, 4;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];
    setp.lt.s32 %p2, %r15, 2;
    setp.ge.s32 %p3, %r15, 2;
    selp.f32 %f2, %f1, 0f00000000, %p2;
    setp.lt.s32 %p4, %r15, 2;
    selp.f32 %f3, %f1, 0f00000000, %p4;
    add.f32 %f4, %f2, %f3;
    mad.lo.s32 %r17, %r15, 1, 0;
    mul.wide.s32 %rd5, %r17, 4;
    add.u64 %rd6, %rd2, %rd5;
